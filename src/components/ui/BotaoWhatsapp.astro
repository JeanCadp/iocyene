---
import { site } from '../../data/site';

interface Props {
  rotuloSuperior?: string;
  variante?: 'padrao' | 'hero' | 'compacto' | 'card' | 'flutuante';
  texto?: string;
  class?: string;
}

const {
  rotuloSuperior = site.botaoWhatsappRotulo,
  variante = 'padrao',
  texto,
  class: className = '',
} = Astro.props;
---

{
  variante === 'padrao' && (
    <a
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'group inline-flex items-center gap-3.5 sm:gap-4 bg-verde hover:bg-verde-medio text-marfim rounded-full px-5 sm:px-6 py-3.5 max-w-full transition-all duration-200 shadow-sm hover:shadow-md',
        className,
      ]}
    >
      <span
        class="w-11 h-11 rounded-full border-2 border-dourado flex items-center justify-center shrink-0 text-dourado"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.59a1 1 0 0 1-.25 1.01l-2.2 2.19z" />
        </svg>
      </span>
      <span class="flex flex-col text-left leading-tight pr-1 sm:pr-2">
        <span class="font-ui text-[14px] font-semibold tracking-[0.1em] uppercase text-dourado">
          {rotuloSuperior}
        </span>
        <span class="font-ui text-[24px] font-bold text-marfim tracking-wide mt-0.5 whitespace-nowrap">
          {site.telefone}
        </span>
      </span>
    </a>
  )
}

{
  variante === 'hero' && (
    <a
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'inline-flex items-center justify-center gap-2.5 w-full sm:w-[290px] h-14 bg-verde hover:bg-verde-medio text-marfim border-2 border-verde hover:border-verde-medio rounded-full px-6 font-ui font-semibold text-sm tracking-[0.08em] uppercase transition-colors whitespace-nowrap shadow-sm',
        className,
      ]}
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="currentColor"
        class="text-dourado shrink-0"
        aria-hidden="true"
      >
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.24-8.23 8.24zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z" />
      </svg>
      <span>{texto ?? rotuloSuperior}</span>
    </a>
  )
}

{
  variante === 'compacto' && (
    <a
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'inline-flex items-center gap-1.5 sm:gap-2 bg-verde hover:bg-verde-medio text-marfim rounded-full px-2.5 py-2 sm:px-4 transition-colors duration-200 whitespace-nowrap shrink-0',
        className,
      ]}
    >
      <span
        class="w-6 h-6 sm:w-7 sm:h-7 rounded-full border border-dourado flex items-center justify-center shrink-0 text-dourado"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
          <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.59a1 1 0 0 1-.25 1.01l-2.2 2.19z" />
        </svg>
      </span>
      <span class="font-ui text-[11px] sm:text-sm font-semibold tracking-[0.04em] sm:tracking-[0.06em] uppercase text-marfim">
        {texto ?? site.ctaMenu}
      </span>
    </a>
  )
}

{
  variante === 'card' && (
    <a
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'inline-flex items-center gap-2 font-ui text-base font-semibold tracking-[0.08em] uppercase text-verde hover:text-verde-medio transition-colors duration-200',
        className,
      ]}
    >
      <span>{texto ?? site.botaoWhatsappRotulo}</span>
    </a>
  )
}

{
  variante === 'flutuante' && (
    <a
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={site.botaoWhatsappRotulo}
      class:list={[
        'fixed bottom-5 right-5 sm:bottom-7 sm:right-7 z-50 w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-verde hover:bg-verde-medio text-marfim border-2 border-dourado shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200 flex items-center justify-center',
        className,
      ]}
    >
      <svg
        viewBox="0 0 24 24"
        width="30"
        height="30"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.24-8.23 8.24zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z" />
      </svg>
    </a>
  )
}
