---
import { textos } from '../data/textos';
import TituloSecao from './ui/TituloSecao.astro';
---

<section
  id="sobre"
  aria-labelledby="titulo-sobre"
  class="py-20 md:py-28 bg-areia border-y border-dourado/40"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <TituloSecao
      sobretitulo={textos.sobre.sobretitulo}
      titulo={textos.sobre.titulo}
      id="titulo-sobre"
    />

    <div class="space-y-6 text-center max-w-3xl mx-auto mb-10">
      {
        textos.sobre.paragrafos.map((paragrafo) => (
          <p class="font-frase text-xl sm:text-2xl text-texto leading-relaxed">
            {paragrafo}
          </p>
        ))
      }
    </div>

    <ul
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 max-w-4xl mx-auto mb-10"
    >
      {
        textos.sobre.selos.map((selo) => (
          <li class="flex items-center justify-center text-center font-ui font-semibold text-base tracking-[0.08em] uppercase text-verde bg-champanhe border border-dourado rounded-full px-4 py-3">
            {selo}
          </li>
        ))
      }
    </ul>

    <p
      class="font-frase italic font-semibold text-[26px] leading-snug text-verde text-center max-w-3xl mx-auto pt-6 border-t border-dourado/50"
    >
      {textos.sobre.notaFormacao}
    </p>
  </div>
</section>
