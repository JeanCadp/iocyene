---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';
import { site } from '../data/site';
import { textos } from '../data/textos';
---

<header
  id="cabecalho"
  class="fixed top-0 inset-x-0 z-50 bg-champanhe/90 backdrop-blur-sm border-b border-dourado/40 transition-all duration-200"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-3"
  >
    <a
      href="#inicio"
      aria-label={site.a11y.irParaInicio}
      class="shrink-0 flex items-center"
    >
      <Image
        src={logoImg}
        alt={textos.rodape.logoAlt}
        width={440}
        height={230}
        class="h-14 sm:h-16 w-auto max-w-[220px] object-contain mix-blend-multiply"
        loading="eager"
      />
    </a>

    <nav
      aria-label={site.a11y.navegacaoPrincipal}
      class="hidden xl:flex items-center gap-5 2xl:gap-7"
    >
      {
        site.menu.map((item) => (
          <a
            href={item.href}
            class="font-ui font-semibold text-base tracking-[0.06em] uppercase text-verde hover:text-verde-medio transition-colors py-1 whitespace-nowrap"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2.5 shrink-0">
      <!-- Ícone do WhatsApp no verde escuro da marca -->
      <a
        href={site.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={site.a11y.whatsappCabecalho}
        class="inline-flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-verde hover:bg-verde-medio text-marfim border border-dourado shadow-sm hover:scale-105 transition-all duration-200 shrink-0"
      >
        <svg
          viewBox="0 0 24 24"
          width="21"
          height="21"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.24-8.23 8.24zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z" />
        </svg>
      </a>

      <!-- Ícone do Instagram na cor oficial do Instagram -->
      <a
        href={site.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={site.a11y.instagramCabecalho}
        class="inline-flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[radial-gradient(circle_at_30%_107%,#fdf497_0%,#fdf497_5%,#fd5949_45%,#d6249f_60%,#285AEB_90%)] text-marfim shadow-sm hover:scale-105 transition-all duration-200 shrink-0"
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.72 3.72 0 0 1-.9 1.38c-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.39A5.89 5.89 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.39 2.13.67.67 1.34 1.08 2.13 1.39.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.89 5.89 0 0 0 2.13-1.39c.67-.67 1.08-1.34 1.39-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.89 5.89 0 0 0-1.39-2.13A5.89 5.89 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z" />
        </svg>
      </a>

      <button
        id="botao-menu-mobile"
        type="button"
        aria-controls="menu-mobile"
        aria-expanded="false"
        aria-label={site.a11y.abrirMenu}
        data-label-abrir={site.a11y.abrirMenu}
        data-label-fechar={site.a11y.fecharMenu}
        class="xl:hidden inline-flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-full border border-dourado bg-areia text-verde hover:bg-champanhe transition-colors shrink-0"
      >
        <svg
          id="icone-menu-abrir"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          id="icone-menu-fechar"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          class="hidden"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="menu-mobile"
    aria-label={site.a11y.navegacaoPrincipal}
    class="hidden xl:hidden bg-areia border-t border-dourado/50 px-4 py-5 shadow-md"
  >
    <ul class="flex flex-col gap-3 max-w-7xl mx-auto">
      {
        site.menu.map((item) => (
          <li>
            <a
              href={item.href}
              class="link-menu-mobile block py-2 px-3 rounded-lg font-ui font-semibold text-base tracking-[0.1em] uppercase text-verde hover:bg-champanhe transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('cabecalho');
  const botao = document.getElementById('botao-menu-mobile');
  const menu = document.getElementById('menu-mobile');
  const iconeAbrir = document.getElementById('icone-menu-abrir');
  const iconeFechar = document.getElementById('icone-menu-fechar');
  const links = document.querySelectorAll('.link-menu-mobile');

  const atualizarHeader = () => {
    if (!header) return;
    if (window.scrollY > 16) {
      header.classList.add('bg-champanhe', 'shadow-sm');
      header.classList.remove('bg-champanhe/90');
    } else {
      header.classList.remove('bg-champanhe', 'shadow-sm');
      header.classList.add('bg-champanhe/90');
    }
  };

  const definirEstadoMenu = (aberto: boolean) => {
    if (!botao || !menu || !iconeAbrir || !iconeFechar) return;
    botao.setAttribute('aria-expanded', String(aberto));
    const labelAbrir = botao.getAttribute('data-label-abrir') ?? '';
    const labelFechar = botao.getAttribute('data-label-fechar') ?? '';
    botao.setAttribute('aria-label', aberto ? labelFechar : labelAbrir);
    menu.classList.toggle('hidden', !aberto);
    iconeAbrir.classList.toggle('hidden', aberto);
    iconeFechar.classList.toggle('hidden', !aberto);
  };

  botao?.addEventListener('click', () => {
    const aberto = botao.getAttribute('aria-expanded') === 'true';
    definirEstadoMenu(!aberto);
  });

  links.forEach((link) => {
    link.addEventListener('click', () => definirEstadoMenu(false));
  });

  window.addEventListener('scroll', atualizarHeader, { passive: true });
  atualizarHeader();
</script>
