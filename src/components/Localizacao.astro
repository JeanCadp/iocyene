---
import { site } from '../data/site';
import { textos } from '../data/textos';
import TituloSecao from './ui/TituloSecao.astro';
---

<section
  id="localizacao"
  aria-labelledby="titulo-localizacao"
  class="py-20 md:py-28 bg-areia border-y border-dourado/40"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <TituloSecao
      sobretitulo={textos.localizacao.sobretitulo}
      titulo={textos.localizacao.titulo}
      id="titulo-localizacao"
    />

    <p
      class="font-frase italic font-semibold text-[24px] sm:text-[26px] leading-snug text-verde-medio text-center max-w-3xl mx-auto mb-12"
    >
      {textos.localizacao.subtitulo}
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 text-center">
      {
        site.locais.map((local) => (
          <div class="bg-champanhe border border-dourado rounded-2xl p-6 sm:p-8 flex flex-col justify-between shadow-sm">
            <div>
              <div class="mb-4">
                <span class="inline-block font-ui font-semibold text-xs sm:text-sm tracking-[0.1em] uppercase text-verde bg-areia border border-dourado/60 px-4 py-1.5 rounded-full">
                  {local.diasResumo}
                </span>
              </div>

              <h3 class="font-titulo font-semibold text-xl sm:text-2xl uppercase tracking-[0.08em] text-verde mb-2 min-h-0 sm:min-h-[4rem] flex items-center justify-center">
                {local.nome}
              </h3>

              <address class="not-italic font-frase text-lg sm:text-xl text-texto leading-snug mb-6 min-h-0 sm:min-h-[3.5rem] flex flex-col justify-center">
                <span class="block">{local.linha1}</span>
                <span class="block">{local.linha2}</span>
              </address>

              <div class="overflow-hidden rounded-xl border border-dourado bg-areia mb-6">
                <iframe
                  src={local.mapsEmbedUrl}
                  title={`Mapa de localização - ${local.nome}`}
                  width="600"
                  height="450"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  class="w-full h-[280px] sm:h-[320px] block"
                />
              </div>
            </div>

            <div class="flex justify-center pt-2">
              <a
                href={local.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-full border-2 border-verde px-7 py-3.5 font-ui font-semibold text-sm sm:text-base tracking-[0.08em] uppercase text-verde hover:bg-verde hover:text-marfim transition-colors"
              >
                {textos.localizacao.botaoMapa}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
