---
import Agenda from '../components/Agenda.astro';
import Atendimentos from '../components/Atendimentos.astro';
import Citacao from '../components/Citacao.astro';
import Contato from '../components/Contato.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Localizacao from '../components/Localizacao.astro';
import Modalidades from '../components/Modalidades.astro';
import Psicanalise from '../components/Psicanalise.astro';
import Sobre from '../components/Sobre.astro';
import BotaoWhatsapp from '../components/ui/BotaoWhatsapp.astro';
import Base from '../layouts/Base.astro';
---

<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Sobre />
    <Psicanalise />
    <Atendimentos />
    <Modalidades />
    <Agenda />
    <Citacao />
    <Faq />
    <Localizacao />
    <Contato />
  </main>
  <Footer />
  <BotaoWhatsapp variante="flutuante" />
</Base>
