---
import { site } from '../data/site';
import { textos } from '../data/textos';
import TituloSecao from './ui/TituloSecao.astro';
---

<section
  id="localizacao"
  aria-labelledby="titulo-localizacao"
  class="py-20 md:py-28 bg-areia border-y border-dourado/40"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <TituloSecao
      sobretitulo={textos.localizacao.sobretitulo}
      titulo={textos.localizacao.titulo}
      id="titulo-localizacao"
    />

    <div
      class="bg-champanhe border border-dourado rounded-2xl p-6 sm:p-8 mb-8 max-w-4xl mx-auto shadow-sm"
    >
      <address
        class="not-italic font-titulo font-semibold text-xl sm:text-2xl uppercase tracking-[0.1em] text-verde leading-relaxed mb-3"
      >
        {textos.localizacao.endereco}
      </address>

      <p
        class="font-frase italic font-semibold text-[26px] leading-snug text-verde-medio mb-6"
      >
        {textos.localizacao.texto}
      </p>

      <div class="overflow-hidden rounded-xl border border-dourado bg-areia">
        <iframe
          src={site.mapsEmbedUrl}
          title={textos.localizacao.mapaTitle}
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          class="w-full h-[300px] sm:h-[380px] md:h-[420px] block"
        ></iframe>
      </div>
    </div>

    <div class="flex justify-center">
      <a
        href={site.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full border-2 border-verde px-7 py-4 font-ui font-semibold text-base tracking-[0.1em] uppercase text-verde hover:bg-verde hover:text-marfim transition-colors"
      >
        {textos.localizacao.botaoMapa}
      </a>
    </div>
  </div>
</section>
