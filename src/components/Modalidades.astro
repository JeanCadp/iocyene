---
import { site } from '../data/site';
import { textos } from '../data/textos';
import IconeCirculo from './ui/IconeCirculo.astro';
import TituloSecao from './ui/TituloSecao.astro';
---

<section
  id="modalidades"
  aria-labelledby="titulo-modalidades"
  class="py-20 md:py-28 bg-champanhe"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <TituloSecao
      sobretitulo={textos.modalidades.sobretitulo}
      titulo={textos.modalidades.titulo}
      id="titulo-modalidades"
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Card Presencial -->
      <article
        class="bg-areia border border-dourado rounded-2xl p-8 sm:p-10 flex flex-col justify-between text-center transition-shadow duration-200 hover:shadow-md"
      >
        <div>
          <div class="flex justify-center mb-6">
            <IconeCirculo
              tipo="presencial"
              rotulo={textos.modalidades.presencial.rotuloIcone}
            />
          </div>

          <h3
            class="font-titulo font-semibold text-2xl uppercase tracking-[0.1em] text-verde mb-4"
          >
            {textos.modalidades.presencial.titulo}
          </h3>

          <p class="font-frase text-xl sm:text-2xl text-texto leading-relaxed mb-6">
            {textos.modalidades.presencial.texto}
          </p>

          <p
            class="font-ui font-semibold text-base tracking-[0.1em] uppercase text-verde bg-champanhe border border-dourado rounded-xl px-4 py-3 mb-8"
          >
            {textos.modalidades.presencial.horarios}
          </p>
        </div>

        <div class="flex justify-center pt-4 border-t border-dourado/50">
          <a
            href={site.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full border-2 border-verde px-7 py-3.5 font-ui font-semibold text-base tracking-[0.1em] uppercase text-verde hover:bg-verde hover:text-marfim transition-colors whitespace-nowrap"
          >
            {textos.modalidades.presencial.botaoMapa}
          </a>
        </div>
      </article>

      <!-- Card Online -->
      <article
        class="bg-areia border border-dourado rounded-2xl p-8 sm:p-10 flex flex-col justify-between text-center transition-shadow duration-200 hover:shadow-md"
      >
        <div>
          <div class="flex justify-center mb-6">
            <IconeCirculo
              tipo="online"
              rotulo={textos.modalidades.online.rotuloIcone}
            />
          </div>

          <h3
            class="font-titulo font-semibold text-2xl uppercase tracking-[0.1em] text-verde mb-4"
          >
            {textos.modalidades.online.titulo}
          </h3>

          <p class="font-frase text-xl sm:text-2xl text-texto leading-relaxed mb-6">
            {textos.modalidades.online.texto}
          </p>

          <p
            class="font-ui font-semibold text-base tracking-[0.1em] uppercase text-verde bg-champanhe border border-dourado rounded-xl px-4 py-3 mb-6"
          >
            {textos.modalidades.online.horarios}
          </p>

          <p
            class="font-frase italic font-semibold text-[26px] leading-snug text-verde-medio"
          >
            {textos.modalidades.online.apoio}
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
