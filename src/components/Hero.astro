---
import { Image } from 'astro:assets';
import fotoImg from '../assets/foto.jpg';
import { site } from '../data/site';
import { textos } from '../data/textos';
import BotaoWhatsapp from './ui/BotaoWhatsapp.astro';
import Filete from './ui/Filete.astro';
---

<section
  id="inicio"
  aria-labelledby="titulo-hero"
  class="relative pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden bg-champanhe"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Celular: foto acima (order-1). Desktop: foto à direita (lg:order-2) -->
      <div class="order-1 lg:order-2 lg:col-span-5 relative mx-auto w-full max-w-sm sm:max-w-md lg:max-w-none">
        <div class="relative p-3 sm:p-4 bg-areia border border-dourado rounded-3xl shadow-md">
          <div class="overflow-hidden rounded-2xl border border-dourado/60">
            <Image
              src={fotoImg}
              alt={textos.hero.fotoAlt}
              widths={[420, 640, 840]}
              sizes="(max-width: 1024px) 90vw, 480px"
              fetchpriority="high"
              loading="eager"
              class="w-full h-[400px] sm:h-[480px] lg:h-[540px] object-cover object-top"
            />
          </div>
        </div>
      </div>

      <!-- Celular: texto abaixo (order-2). Desktop: texto à esquerda (lg:order-1) -->
      <div class="order-2 lg:order-1 lg:col-span-7 text-center lg:text-left">
        <p
          class="font-ui font-semibold text-base tracking-[0.1em] uppercase text-verde mb-3"
        >
          {textos.hero.sobretitulo}
        </p>

        <h1
          id="titulo-hero"
          class="font-frase font-semibold text-4xl sm:text-5xl xl:text-[3.5rem] text-texto leading-[1.12] tracking-[-0.01em]"
        >
          {textos.hero.tituloPartes.inicio}<span
            class="font-bold text-verde-destaque"
            >{textos.hero.tituloPartes.destaque1}</span
          >{textos.hero.tituloPartes.meio}<span
            class="font-bold text-verde-destaque"
            >{textos.hero.tituloPartes.destaque2}</span
          >{textos.hero.tituloPartes.fim}
        </h1>

        <Filete class="justify-center lg:justify-start" />

        <p
          class="font-frase text-xl sm:text-2xl text-texto leading-relaxed max-w-2xl mx-auto lg:mx-0 mb-8"
        >
          {textos.hero.texto}
        </p>

        <!-- Conheça meu trabalho à esquerda e Agende pelo WhatsApp à direita, ambos com o mesmo tamanho -->
        <div
          class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8"
        >
          <a
            href={textos.hero.botaoSecundario.href}
            class="inline-flex items-center justify-center w-full sm:w-[290px] h-14 rounded-full border-2 border-verde px-6 font-ui font-semibold text-sm tracking-[0.08em] uppercase text-verde hover:bg-verde hover:text-marfim transition-colors whitespace-nowrap"
          >
            {textos.hero.botaoSecundario.label}
          </a>

          <BotaoWhatsapp
            variante="hero"
            texto={site.botaoWhatsappRotulo}
          />
        </div>

        <div class="pt-4 border-t border-dourado/60 space-y-1.5">
          <p
            class="font-ui font-semibold text-base tracking-[0.1em] uppercase text-verde"
          >
            {textos.hero.linhaApoio1}
          </p>
          <p
            class="font-ui font-semibold text-base tracking-[0.1em] uppercase text-verde-medio"
          >
            {textos.hero.linhaApoio2}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
