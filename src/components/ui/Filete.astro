---
import Estrela from './Estrela.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={['flex items-center justify-center gap-3 my-4', className]}
  aria-hidden="true"
>
  <span class="block w-[120px] max-w-[32vw] h-[1.5px] bg-dourado"></span>
  <Estrela size={18} class="text-dourado shrink-0" />
  <span class="block w-[120px] max-w-[32vw] h-[1.5px] bg-dourado"></span>
</div>

